diff --git a/src/app/api/robinhood/risk/route.ts b/src/app/api/robinhood/risk/route.ts
new file mode 100644
index 0000000..7b89439
--- /dev/null
+++ b/src/app/api/robinhood/risk/route.ts
@@ -0,0 +1,68 @@
+import { NextResponse } from "next/server";
+import { getBlockscoutApiUrl, getBlockscoutHeaders } from "@/lib/robinhood/config";
+import { checkRobinhoodRateLimit } from "@/lib/robinhood/rate-limit";
+
+export const dynamic = "force-dynamic";
+export const revalidate = 0;
+
+type Dict = Record<string, unknown>;
+const isRecord = (value: unknown): value is Dict => typeof value === "object" && value !== null && !Array.isArray(value);
+const str = (value: unknown): string | null => typeof value === "string" ? value : typeof value === "number" ? String(value) : null;
+
+export async function GET(request: Request) {
+  const limit = checkRobinhoodRateLimit(request, "risk", 12);
+  if (!limit.allowed) return NextResponse.json({ ok: false, error: "Too many risk-analysis requests. Wait a moment and retry." }, { status: 429, headers: { "Retry-After": String(limit.retryAfterSeconds), "Cache-Control": "no-store" } });
+  const address = new URL(request.url).searchParams.get("address")?.trim() ?? "";
+  if (!/^0x[a-fA-F0-9]{40}$/.test(address)) return NextResponse.json({ ok: false, error: "Enter a valid EVM contract address." }, { status: 400 });
+
+  try {
+    const [tokenResponse, contractResponse] = await Promise.all([
+      fetch(getBlockscoutApiUrl(`/tokens/${address}`), { headers: getBlockscoutHeaders(), cache: "no-store", signal: AbortSignal.timeout(8000) }),
+      fetch(getBlockscoutApiUrl(`/smart-contracts/${address}`), { headers: getBlockscoutHeaders(), cache: "no-store", signal: AbortSignal.timeout(8000) }).catch(() => null),
+    ]);
+    if (tokenResponse.status === 401 || tokenResponse.status === 403) return NextResponse.json({ ok: false, error: "Blockscout menolak akses. Periksa BLOCKSCOUT_PRO_API_KEY di environment server." }, { status: 502 });
+    if (!tokenResponse.ok && tokenResponse.status !== 404) return NextResponse.json({ ok: false, error: `Token data source returned HTTP ${tokenResponse.status}.` }, { status: 502 });
+    let tokenData: Dict = {};
+    if (tokenResponse.ok) {
+      const parsed: unknown = await tokenResponse.json().catch(() => null);
+      tokenData = isRecord(parsed) ? parsed : {};
+    }
+    let contractData: Dict = {};
+    if (contractResponse?.ok) {
+      const parsed: unknown = await contractResponse.json().catch(() => null);
+      if (isRecord(parsed)) contractData = parsed;
+    }
+    const abiValue = contractData.abi;
+    let abi: unknown[] = [];
+    if (Array.isArray(abiValue)) abi = abiValue;
+    else if (typeof abiValue === "string") { try { const parsed: unknown = JSON.parse(abiValue); if (Array.isArray(parsed)) abi = parsed; } catch { /* ABI may be unavailable or malformed */ } }
+    const functions = abi.filter((item): item is Dict => isRecord(item) && item.type === "function").map((item) => str(item.name)).filter((name): name is string => Boolean(name));
+    const privilegedPatterns = [
+      { pattern: /(^|_)mint($|_)/i, label: "Mint-related function detected", points: 18 },
+      { pattern: /blacklist|blocklist|denylist/i, label: "Address restriction function detected", points: 12 },
+      { pattern: /pause|unpause/i, label: "Pause control detected", points: 8 },
+      { pattern: /set(owner|tax|fee|router|implementation)|upgradeTo|upgradeToAndCall/i, label: "Administrative or upgrade function detected", points: 12 },
+      { pattern: /renounceOwnership/i, label: "Ownership renunciation function detected (not proof ownership was renounced)", points: 0 },
+    ];
+    const verified = contractData.is_verified === true || tokenData.is_verified === true || Boolean(contractData.source_code) || Boolean(contractData.abi);
+    const findings: Array<{ severity: "info" | "warning"; title: string; detail: string }> = [];
+    let score = 0;
+    if (!verified) { score += 25; findings.push({ severity: "warning", title: "Source code not verified in this explorer response", detail: "Bytecode behavior cannot be fully assessed from the available indexed data." }); }
+    else findings.push({ severity: "info", title: "Verified source/ABI appears available", detail: "Verification helps inspection but does not establish that the contract is safe." });
+    for (const item of privilegedPatterns) {
+      const matches = functions.filter((name) => item.pattern.test(name));
+      if (matches.length) {
+        score += item.points;
+        findings.push({ severity: item.points > 0 ? "warning" : "info", title: item.label, detail: `ABI function names: ${matches.slice(0, 8).join(", ")}. Function presence alone does not prove malicious behavior.` });
+      }
+    }
+    if (!functions.length) findings.push({ severity: "info", title: "Function-level inspection unavailable", detail: "No usable verified ABI was returned; this is an evidence gap, not a safety verdict." });
+    const holderCount = str(tokenData.holders) ?? str(tokenData.holders_count);
+    const scoreClamped = Math.min(100, score);
+    const label = scoreClamped >= 50 ? "Elevated indicators" : scoreClamped >= 25 ? "Needs review" : "Limited indicators detected";
+    return NextResponse.json({ ok: true, data: { address, token: { name: str(tokenData.name), symbol: str(tokenData.symbol), holders: holderCount, verified: verified || null }, contract: { verified, compilerVersion: str(contractData.compiler_version), language: str(contractData.language), proxy: contractData.is_proxy === true ? true : contractData.is_proxy === false ? false : null }, score: scoreClamped, label, findings, functions: functions.slice(0, 80), fetchedAt: new Date().toISOString(), source: "Robinhood Chain Blockscout indexed data", disclaimer: "Heuristic triage only; not a security audit or guarantee. Missing indexed data is not treated as proof of safety." } }, { headers: { "Cache-Control": "no-store" } });
+  } catch (error) {
+    const message = error instanceof Error && error.name === "TimeoutError" ? "Risk analysis timed out while requesting indexed contract data." : "Could not retrieve enough indexed data to analyze this contract.";
+    return NextResponse.json({ ok: false, error: message }, { status: 502, headers: { "Cache-Control": "no-store" } });
+  }
+}
diff --git a/src/app/api/robinhood/rpc/route.ts b/src/app/api/robinhood/rpc/route.ts
new file mode 100644
index 0000000..ad1c096
--- /dev/null
+++ b/src/app/api/robinhood/rpc/route.ts
@@ -0,0 +1,32 @@
+import { NextResponse } from "next/server";
+import { getRobinhoodRpcUrl } from "@/lib/robinhood/config";
+import { checkRobinhoodRateLimit } from "@/lib/robinhood/rate-limit";
+
+export const dynamic = "force-dynamic";
+export const revalidate = 0;
+
+const READ_METHODS = new Set(["eth_chainId", "eth_blockNumber", "eth_gasPrice", "eth_getBlockByNumber"]);
+export async function POST(request: Request) {
+  const limit = checkRobinhoodRateLimit(request, "rpc-playground", 20);
+  if (!limit.allowed) return NextResponse.json({ ok: false, error: "RPC playground rate limit reached. Wait and retry." }, { status: 429, headers: { "Retry-After": String(limit.retryAfterSeconds), "Cache-Control": "no-store" } });
+  try {
+    const body: unknown = await request.json();
+    if (typeof body !== "object" || body === null || Array.isArray(body)) return NextResponse.json({ ok: false, error: "Send a JSON object containing method and params." }, { status: 400 });
+    const { method, params } = body as { method?: unknown; params?: unknown };
+    if (typeof method !== "string" || !READ_METHODS.has(method)) return NextResponse.json({ ok: false, error: "Only read-only methods are allowed: eth_chainId, eth_blockNumber, eth_gasPrice, eth_getBlockByNumber." }, { status: 400 });
+    const safeParams = params === undefined ? [] : params;
+    if (!Array.isArray(safeParams) || safeParams.length > 2 || safeParams.some((item) => typeof item !== "string" && typeof item !== "boolean" && item !== null)) return NextResponse.json({ ok: false, error: "RPC params must be an array of up to two simple values." }, { status: 400 });
+    if (method === "eth_getBlockByNumber" && (safeParams.length !== 2 || typeof safeParams[0] !== "string" || typeof safeParams[1] !== "boolean")) return NextResponse.json({ ok: false, error: "eth_getBlockByNumber expects [blockTag, includeTransactions]." }, { status: 400 });
+    if (method !== "eth_getBlockByNumber" && safeParams.length !== 0) return NextResponse.json({ ok: false, error: `${method} does not accept parameters in this playground.` }, { status: 400 });
+    const response = await fetch(getRobinhoodRpcUrl(), { method: "POST", headers: { "content-type": "application/json", accept: "application/json" }, body: JSON.stringify({ jsonrpc: "2.0", id: 1, method, params: safeParams }), cache: "no-store", signal: AbortSignal.timeout(8000) });
+    if (!response.ok) return NextResponse.json({ ok: false, error: `Robinhood RPC returned HTTP ${response.status}. Check the server-side Alchemy configuration.` }, { status: 502 });
+    const payload: unknown = await response.json();
+    if (typeof payload !== "object" || payload === null || Array.isArray(payload)) return NextResponse.json({ ok: false, error: "RPC returned an unexpected response." }, { status: 502 });
+    const result = payload as { result?: unknown; error?: { message?: string; code?: number } };
+    if (result.error) return NextResponse.json({ ok: false, error: result.error.message ?? "RPC returned an error.", code: result.error.code }, { status: 502 });
+    return NextResponse.json({ ok: true, method, result: result.result, fetchedAt: new Date().toISOString(), network: "Robinhood Chain Mainnet · 4663" }, { headers: { "Cache-Control": "no-store" } });
+  } catch (error) {
+    const message = error instanceof Error && error.message.includes("not configured") ? error.message : error instanceof Error && error.name === "TimeoutError" ? "Robinhood RPC request timed out." : "Could not reach Robinhood Chain RPC. Check server-side configuration.";
+    return NextResponse.json({ ok: false, error: message }, { status: 502, headers: { "Cache-Control": "no-store" } });
+  }
+}
diff --git a/src/app/api/robinhood/scanner/route.ts b/src/app/api/robinhood/scanner/route.ts
new file mode 100644
index 0000000..5d74ef7
--- /dev/null
+++ b/src/app/api/robinhood/scanner/route.ts
@@ -0,0 +1,54 @@
+import { NextResponse } from "next/server";
+import { getBlockscoutApiUrl, getBlockscoutHeaders } from "@/lib/robinhood/config";
+import { checkRobinhoodRateLimit } from "@/lib/robinhood/rate-limit";
+
+export const dynamic = "force-dynamic";
+export const revalidate = 0;
+
+type RecordValue = Record<string, unknown>;
+function record(value: unknown): value is RecordValue { return typeof value === "object" && value !== null && !Array.isArray(value); }
+function str(value: unknown): string | null { return typeof value === "string" || typeof value === "number" ? String(value) : null; }
+
+export async function GET(request: Request) {
+  const limit = checkRobinhoodRateLimit(request, "scanner", 20);
+  if (!limit.allowed) return NextResponse.json({ ok: false, error: "Scanner rate limit reached. Wait a moment and retry." }, { status: 429, headers: { "Retry-After": String(limit.retryAfterSeconds), "Cache-Control": "no-store" } });
+  const url = new URL(request.url);
+  const sortValue = url.searchParams.get("sort") ?? "holders_count";
+  const sort = ["holders_count", "fiat_value", "circulating_market_cap"].includes(sortValue) ? sortValue : "holders_count";
+  const q = (url.searchParams.get("q") ?? "").trim().slice(0, 80);
+  const api = new URL(getBlockscoutApiUrl("/tokens"));
+  api.searchParams.set("type", "ERC-20");
+  api.searchParams.set("sort", sort);
+  api.searchParams.set("order", "desc");
+  api.searchParams.set("items_count", "20");
+  if (q) api.searchParams.set("q", q);
+  try {
+    const response = await fetch(api, { headers: getBlockscoutHeaders(), cache: "no-store", signal: AbortSignal.timeout(10000) });
+    if (!response.ok) {
+      const status = response.status === 401 || response.status === 403 ? 502 : response.status;
+      const message = response.status === 401 || response.status === 403
+        ? "Blockscout menolak akses API. Pastikan BLOCKSCOUT_PRO_API_KEY valid dan sudah diatur di environment server Vercel."
+        : `Blockscout token scanner returned HTTP ${response.status}.`;
+      return NextResponse.json({ ok: false, error: message }, { status, headers: { "Cache-Control": "no-store" } });
+    }
+    const body: unknown = await response.json();
+    if (!record(body) || !Array.isArray(body.items)) return NextResponse.json({ ok: false, error: "Blockscout returned an unexpected token list." }, { status: 502 });
+    const items = body.items.filter(record).map((item) => ({
+      address: str(item.address) ?? str(item.address_hash) ?? str(item.contract_address_hash),
+      name: str(item.name) ?? "Unknown token",
+      symbol: str(item.symbol),
+      decimals: str(item.decimals),
+      holders: str(item.holders) ?? str(item.holders_count),
+      marketCap: str(item.circulating_market_cap) ?? str(item.market_cap),
+      fiatValue: str(item.exchange_rate) ?? str(item.fiat_value),
+      totalSupply: str(item.total_supply),
+      type: str(item.type) ?? "ERC-20",
+      verified: typeof item.is_verified === "boolean" ? item.is_verified : null,
+      explorerUrl: (str(item.address) ?? str(item.address_hash) ?? str(item.contract_address_hash)) ? `https://robinhoodchain.blockscout.com/token/${str(item.address) ?? str(item.address_hash) ?? str(item.contract_address_hash)}` : "https://robinhoodchain.blockscout.com/",
+    })).filter((item) => item.address);
+    return NextResponse.json({ ok: true, data: { items, count: items.length, fetchedAt: new Date().toISOString(), source: process.env.BLOCKSCOUT_PRO_API_KEY ? "Blockscout PRO API · Robinhood Chain" : "Robinhood Chain Blockscout API" } }, { headers: { "Cache-Control": "no-store" } });
+  } catch (error) {
+    const message = error instanceof Error && error.name === "TimeoutError" ? "Blockscout request timed out. Retry in a moment." : "Unable to reach the Blockscout token index. Check API configuration and try again.";
+    return NextResponse.json({ ok: false, error: message }, { status: 502, headers: { "Cache-Control": "no-store" } });
+  }
+}
